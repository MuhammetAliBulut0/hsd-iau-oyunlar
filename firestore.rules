rules_version = '2';
// HSD İAÜ Tanışma Oyunları · Firestore güvenlik kuralları
// Firebase konsolu > Firestore Database > Rules sekmesine bu dosyanın TAMAMINI yapıştırıp Publish'e basın.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email; }
    function isSuper() {
      return signedIn() && request.auth.token.email_verified == true
        && myEmail() == 'muhammetalib571@gmail.com';
    }
    function isMod() {
      return isSuper() || (signedIn() && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/mods/$(myEmail())));
    }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function gameStatus(g) {
      return exists(/databases/$(database)/documents/games/$(g))
        ? get(/databases/$(database)/documents/games/$(g)).data.status : 'off';
    }

    // ---------- Genel ----------
    match /mods/{email} {
      allow read: if signedIn();
      allow write: if isSuper();
    }
    // E-postalı katılımcı listesi: sadece moderatörler görür
    match /users/{uid} {
      allow read: if isMe(uid) || isMod();
      allow create, update: if isMe(uid);
      allow delete: if isMod();
    }
    // Herkesin görebildiği adlar (bingo kutuları, oyuncu listeleri)
    match /people/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid);
      allow delete: if isMod();
    }
    match /state/{doc} {
      allow read: if signedIn();
      allow write: if isMod();
    }
    // Oyun durumları (bingo, dare, lie)
    match /games/{g} {
      allow read: if signedIn();
      allow write: if isMod();
    }

    // ---------- Tech Bingo ----------
    match /bingoCards/{uid} {
      allow read: if isMe(uid) || isMod();
      allow create, update: if isMe(uid) && gameStatus('bingo') == 'running';
      allow delete: if isMod();
    }
    // O an bingo oynayanların adları (kutulara sadece bunlar yazılabilir)
    match /bingoPlayers/{uid} {
      allow read: if signedIn();
      allow create, update: if isMe(uid) && gameStatus('bingo') == 'running';
      allow delete: if isMod();
    }
    match /bingoWins/{uid} {
      allow read: if signedIn();
      allow create: if isMe(uid) && gameStatus('bingo') == 'running'
        && request.resource.data.at == request.time
        && getAfter(/databases/$(database)/documents/bingoCards/$(uid)).data.lines > 0;
      allow update, delete: if isMod();
    }

    // ---------- Hız Tanışması ----------
    match /speed/{doc} {
      allow read: if signedIn();
      allow write: if isMod();
    }

    // ---------- Katil Kim? (Vampir Köylü odaları) ----------
    match /ww/{room} {
      function phase() { return get(/databases/$(database)/documents/ww/$(room)).data.phase; }
      function alive(uid) {
        return exists(/databases/$(database)/documents/ww/$(room)/players/$(uid))
          && get(/databases/$(database)/documents/ww/$(room)/players/$(uid)).data.alive == true;
      }
      allow read: if signedIn();
      allow write: if isMod();
      match /players/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid) && phase() == 'lobby' && request.resource.data.alive == true;
        allow update: if isMod();
        allow delete: if isMod() || (isMe(uid) && phase() == 'lobby');
      }
      match /roles/{uid} {
        allow read: if isMe(uid) || isMod();
        allow write: if isMod();
      }
      match /inbox/{uid} {
        allow read: if isMe(uid) || isMod();
        allow write: if isMod();
      }
      match /actions/{uid} {
        allow read: if isMe(uid) || isMod();
        allow create, update: if isMe(uid) && alive(uid) && phase() in ['night', 'result'];
        allow delete: if isMod();
      }
      match /votes/{uid} {
        allow read: if signedIn();
        allow create, update: if isMe(uid) && alive(uid) && phase() == 'vote';
        allow delete: if isMod();
      }
    }

    // ---------- Cesaret ----------
    match /dareSubs/{uid} {
      allow read: if isMe(uid) || isMod();
      allow create, update: if isMod() || (isMe(uid)
        && gameStatus('dare') in ['collect', 'running']
        && request.resource.data.status == 'ok'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 200);
      allow delete: if isMod();
    }
    match /dareGot/{uid} {
      allow read: if isMe(uid) || isMod();
      allow create, delete: if isMod();
      allow update: if isMod() || (isMe(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result', 'resultAt']));
    }

    // ---------- Ben Kimim (Tabu grupları) ----------
    match /tabu/{g} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.status == 'pending'
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isMod() || (
        exists(/databases/$(database)/documents/tabu/$(g)/members/$(request.auth.uid))
        && resource.data.status != 'pending'
        && request.resource.data.status in ['approved', 'playing', 'ended']
        && request.resource.data.hostUid == resource.data.hostUid);
      allow delete: if isMod() || (resource.data.createdBy == request.auth.uid && resource.data.status == 'pending');
      match /members/{uid} {
        allow read: if signedIn();
        allow create: if isMe(uid)
          && get(/databases/$(database)/documents/tabu/$(g)).data.status in ['pending', 'approved'];
        allow update: if isMod();
        allow delete: if isMe(uid) || isMod();
      }
    }

    // ---------- 2 Doğru 1 Yalan ----------
    match /lieSubs/{uid} {
      allow read: if isMe(uid) || isMod();
      allow create: if isMod() || (isMe(uid) && gameStatus('lie') in ['collect', 'stage']
        && request.resource.data.status == 'ok' && request.resource.data.played == false);
      allow update: if isMod() || (isMe(uid) && gameStatus('lie') in ['collect', 'stage']
        && resource.data.played == false
        && request.resource.data.status == 'ok' && request.resource.data.played == false);
      allow delete: if isMod();
    }
    match /lieStage/{doc} {
      allow read: if signedIn();
      allow write: if isMod();
    }
    match /lieStageSecret/{doc} {
      allow read, write: if isMod();
    }
    match /lieVotes/{id} {
      allow read: if isMod() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.round + '_' + request.auth.uid
        && get(/databases/$(database)/documents/lieStage/current).data.open == true
        && get(/databases/$(database)/documents/lieStage/current).data.round == request.resource.data.round
        && get(/databases/$(database)/documents/lieStage/current).data.uid != request.auth.uid;
      allow delete: if isMod();
    }
    match /lieResults/{uid} {
      allow read: if signedIn();
      allow write: if isMod();
    }
    match /lieHunt/{uid} {
      allow read: if isMe(uid) || isMod();
      allow write: if isMod();
    }
    match /lieGuess/{uid} {
      allow read: if isMe(uid) || isMod();
      allow create, update: if isMe(uid) && gameStatus('lie') == 'hunt';
      allow delete: if isMod();
    }
  }
}
